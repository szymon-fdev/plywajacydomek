<article class="amenities__card">
    <div class="amenities__slider">
        <div class="amenities__track">
            <div class="amenities__slide" style="background-image: url('<!-- $img1 -->')"></div>
            <div class="amenities__slide" style="background-image: url('<!-- $img2 -->')"></div>
            <!-- if $img3 -->
            <div class="amenities__slide" style="background-image: url('<!-- $img3 -->')"></div>
            <!-- endif -->
        </div>
        <button class="amenities__nav amenities__nav--prev">&lsaquo;</button>
        <button class="amenities__nav amenities__nav--next">&rsaquo;</button>
    </div>
    <div class="amenities__info">
        <h3><!-- $title --></h3>
        <p><!-- $desc --></p>
    </div>
</article>
