<article class="amenities__card">
    <div class="amenities__slider">
        <div class="amenities__track">
            <img src="<!-- $img1 -->" alt="<!-- $title -->" class="amenities__slide" loading="lazy" decoding="async" width="500" height="250" />
            <img src="<!-- $img2 -->" alt="<!-- $title -->" class="amenities__slide" loading="lazy" decoding="async" width="500" height="250" />
            <!-- if $img3 -->
            <img src="<!-- $img3 -->" alt="<!-- $title -->" class="amenities__slide" loading="lazy" decoding="async" width="500" height="250" />
            <!-- endif -->
        </div>
        <button class="amenities__nav amenities__nav--prev">&lsaquo;</button>
        <button class="amenities__nav amenities__nav--next">&rsaquo;</button>
    </div>
    <div class="amenities__info">
        <h3><!-- $title --></h3>
        <p><!-- $desc --></p>
    </div>
</article>
