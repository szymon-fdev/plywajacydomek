<article class="cottage-card">
    <div class="cottage-card__media">
        <a href="<!-- $img1 -->" class="cottage-card__cover glightbox" data-gallery="<!-- $id -->">
            <img src="<!-- $img1 -->" alt="<!-- $title -->" class="cottage-card__img" loading="lazy" />
            <span class="cottage-card__badge">
                <i class="bi bi-images"></i>
            </span>
        </a>
        <p class="section__sub-info"><i class="bi bi-arrow-up-circle"></i> Kliknij w zdjęcie, aby zobaczyć wnętrze obiektu.</p>
        <div style="display: none">
            <a href="<!-- $img2 -->" class="glightbox" data-gallery="<!-- $id -->"></a>
            <a href="<!-- $img3 -->" class="glightbox" data-gallery="<!-- $id -->"></a>
            <a href="<!-- $img4 -->" class="glightbox" data-gallery="<!-- $id -->"></a>
            <a href="<!-- $img5 -->" class="glightbox" data-gallery="<!-- $id -->"></a>
            <a href="<!-- $img6 -->" class="glightbox" data-gallery="<!-- $id -->"></a>
            <a href="<!-- $img7 -->" class="glightbox" data-gallery="<!-- $id -->"></a>
            <a href="<!-- $img8 -->" class="glightbox" data-gallery="<!-- $id -->"></a>
            <a href="<!-- $img9 -->" class="glightbox" data-gallery="<!-- $id -->"></a>
        </div>
    </div>

    <div class="cottage-card__content">
        <h3 class="cottage-card__title"><!-- $title --></h3>
        <p class="cottage-card__desc-attributes"><!-- $attributes --></p>
        <p class="cottage-card__desc"><!-- $desc --></p>
        <button class="cottage-card__link js-open-modal">
            Sprawdź dostępność <i class="bi bi-arrow-right"></i>
        </button>
    </div>
</article>
