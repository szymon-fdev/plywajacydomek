<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="preconnect" href="https://cdn.jsdelivr.net" />
<link rel="icon" href="./dist/img/favicon.svg" type="image/svg+xml" />
<link rel="preload" as="image" href="./dist/img/herobg2-mb.webp" media="(max-width: 991.98px)" fetchpriority="high" />
<link rel="preload" as="image" href="./dist/img/herobg2.webp" media="(min-width: 992px)" fetchpriority="high" />
<link rel="stylesheet" href="./dist/css/main.min.css" />
<link
    rel="preload"
    href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600&family=Fraunces:opsz,wght@9..144,500;600&display=swap"
    as="style"
    onload="
        this.onload = null;
        this.rel = 'stylesheet';
    "
/>
<noscript>
    <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600&family=Fraunces:opsz,wght@9..144,500;600&display=swap"
    />
</noscript>
<link
    rel="preload"
    href="https://cdn.jsdelivr.net/npm/glightbox/dist/css/glightbox.min.css"
    as="style"
    onload="
        this.onload = null;
        this.rel = 'stylesheet';
    "
/>
<noscript><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/glightbox/dist/css/glightbox.min.css" /></noscript>

<link
    rel="preload"
    href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    as="style"
    onload="
        this.onload = null;
        this.rel = 'stylesheet';
    "
/>
<noscript><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" /></noscript>
