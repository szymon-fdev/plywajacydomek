<!-- Schemat 1: Jasny (Domyślny) -->
<section class="theme-scheme-1 test-section">
    <div class="test-container">
        <h2 class="test-heading">Schemat 1: Jasny</h2>
        <p class="test-text">To jest testowy paragraf. Sprawdzamy, czy widać ciemny tekst na bazowym białym tle.</p>

        <div class="test-card">
            <p class="test-text-muted">
                To jest karta z drugorzędnym tłem (background-secondary), krawędzią (border) i wyblakłym tekstem (text-muted).
            </p>
            <a href="#" class="test-button">Przycisk Akcentu</a>
        </div>
    </div>
</section>

<!-- Schemat 2: Pastelowy / Szary -->
<section class="theme-scheme-2 test-section">
    <div class="test-container">
        <h2 class="test-heading">Schemat 2: Pastelowy</h2>
        <p class="test-text">To jest testowy paragraf. Tło powinno być teraz delikatnie zielonkawe/szare.</p>

        <div class="test-card">
            <p class="test-text-muted">
                To jest karta z drugorzędnym tłem (background-secondary), krawędzią (border) i wyblakłym tekstem (text-muted).
            </p>
            <a href="#" class="test-button">Przycisk Akcentu</a>
        </div>
    </div>
</section>

<!-- Schemat 3: Ciemny -->
<section class="theme-scheme-3 test-section">
    <div class="test-container">
        <h2 class="test-heading">Schemat 3: Ciemny</h2>
        <p class="test-text">To jest testowy paragraf. Tutaj sprawdzamy, czy czyta jasny tekst na bardzo ciemnym zielonym/czarnym tle.</p>

        <div class="test-card">
            <p class="test-text-muted">
                To jest karta z drugorzędnym tłem (background-secondary), krawędzią (border) i wyblakłym tekstem (text-muted).
            </p>
            <a href="#" class="test-button">Przycisk Akcentu</a>
        </div>
    </div>
</section>
