<section class="testimonials section theme-scheme-1" id="testimonials-section">
    <div class="container">
        <span class="section__tag">Opinie gości</span>
        <h2 class="section__heading">Co mówią nasi goście</h2>
        <div class="testimonials__track" data-slider-track>
            <!-- Karta 1 -->
            <!-- $reviewText = Piękne jezioro za drzwiami, choć najlepsze widoki są z "górnego pokładu". W domku jest bardzo przytulnie i miło. Wyjątkowe miejsce i spokojna okolica. Spędziliśmy ten czas aktywnie, pogoda dopisała. Wrócimy 😊 -->
            <!-- $authorName = Blue03 -->
            <!-- @import "_review-card.kit" -->

            <!-- Karta 2 -->
            <!-- $reviewText = Piękne miejsce, idealne dla osób lubiących kontakt z naturą. Cisza, spokój i obłędny widok na jezioro. Wspaniali właściciele, którzy dbali, by niczego nam nie brakowało ❤️ -->
            <!-- $authorName = Delfina -->
            <!-- @import "_review-card.kit" -->

            <!-- Karta 3 -->
            <!-- $reviewText = Myślałam, że domek na wodzie to taki kaprys, zbędny " bajer". O, jakże się myliłam! Niczym niezakłócony widok na jezioro, z poziomu jeziora, oczarował mnie do głębi! Cudowne doświadczenie. Gospodarz przemiły i pomocny. Miejsce klimatczne i urocze. Serdecznie polecam! -->
            <!-- $authorName = Dobrucka -->
            <!-- @import "_review-card.kit" -->

            <!-- Karta 5 -->
            <!-- $reviewText = Przepiękne miejsce, mnóstwo dobrej energii, dopracowanych detali i aktywności dostępnych na miejscu. Dom sam w sobie bardzo komfortowy, a widok na jezioro o poranku to coś z bajki! Właściciel bardzo miły, dbał i zaglądał czy wszystko jest ok. Absolutnie polecam, wrócę na pewno. -->
            <!-- $authorName = Ewa -->
            <!-- @import "_review-card.kit" -->

            <!-- Karta 4 -->
            <!-- $reviewText = Bardzo klimatyczne miejsce. Domek pięknie urządzony, funkcjonalny. Wspaniałe widoki. Wiele atrakcji: łódki, supy, balia, sauna. Nie da się tu nudzić ;) do tego bardzo pomocny i sympatyczny właściciel :) -->
            <!-- $authorName = Kinga -->
            <!-- @import "_review-card.kit" -->
        </div>

        <div class="testimonials__controls">
            <div class="testimonials__dots" aria-hidden="true" data-slider-dots>
                <span class="testimonials__dot testimonials__dot--active" data-index="0"></span>
                <span class="testimonials__dot" data-index="1"></span>
                <span class="testimonials__dot" data-index="2"></span>
                <span class="testimonials__dot" data-index="3"></span>
                <span class="testimonials__dot" data-index="4"></span>
            </div>

            <div class="testimonials__arrows">
                <button class="testimonials__arrow" data-slider-prev aria-label="Poprzednia opinia">
                    <i class="bi bi-arrow-left-short"></i>
                </button>
                <button class="testimonials__arrow" data-slider-next aria-label="Następna opinia">
                    <i class="bi bi-arrow-right-short"></i>
                </button>
            </div>
        </div>
    </div>
</section>
